# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase: the web config lives in firebase-applet-config.json (these keys are public by design;
# access is protected by firestore.rules and storage.rules), so no Firebase variables are required.
#
# Optional: point the site at a different Firestore database (for example a test database).
# Leave unset to use "firestoreDatabaseId" from firebase-applet-config.json.
# VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-thegreatmissionc-b0a51e3f-cce4-4e2e-82a7-5d9b232e1cc3"
